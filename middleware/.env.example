# Logfire (Get yours from https://logfire-us.pydantic.dev)
LOGFIRE_TOKEN=pylf_v1_...
LOGFIRE_PROJECT_NAME=vibechatbot

# Ollama
OLLAMA_BASE_URL=http://localhost:11434

# Required for non-dev use: Bearer token middleware accepts (same value as OpenWebUI OPENAI_API_KEY).
# Leave unset only for local debugging with no auth.
API_KEY=local-dev-api-key

# Browser origins allowed to call the API (comma-separated). Match your OpenWebUI URL(s).
# Use CORS_ORIGINS=* only for wide-open local testing (credentials disabled per browser rules).
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
